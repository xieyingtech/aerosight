{
  "name": "aerosight",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "predev": "pnpm db:migrate",
    "dev": "pnpm run \"/^dev:.*/\"",
    "prestart": "pnpm db:migrate",
    "start": "pnpm run \"/^start:.*/\"",
    "spec": "openspec",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:worker": "node scripts/dev-worker.mjs",
    "start:web": "pnpm --dir apps/web exec next start",
    "start:worker": "node scripts/start-worker.mjs",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "pnpm --dir apps/web build",
    "build:worker": "cd apps/server && go build -o ../../.build/aerosight-worker ./cmd/worker",
    "test": "pnpm test:web && pnpm test:worker",
    "db:migrate": "pnpm --dir apps/web db:migrate",
    "test:migrations": "pnpm --dir apps/web test:migrations",
    "test:web": "pnpm --dir apps/web test:unit",
    "test:worker": "pnpm prepare:server && cd apps/server && go test -tags dev ./...",
    "test:security": "node scripts/test-security-acceptance.mjs",
    "test:all": "pnpm test && pnpm test:migrations && pnpm test:security",
    "benchmark:load": "pnpm --dir apps/web benchmark:load",
    "drill:fresh-environment": "node scripts/fresh-environment-drill.mjs",
    "drill:upgrade-rollback": "pnpm --dir apps/web drill:upgrade-rollback",
    "typecheck": "pnpm --dir apps/web typecheck",
    "check": "pnpm typecheck && pnpm test",
    "db:generate": "node scripts/sqlc.mjs",
    "db:check": "node scripts/sqlc.mjs --check",
    "prepare:server": "node scripts/prepare-server.mjs",
    "prepare:web": "node scripts/prepare-web.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.10.0"
  }
}
