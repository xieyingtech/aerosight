{
  "name": "aerosight",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/run-server.mjs serve",
    "spec": "openspec",
    "dev:web": "pnpm --dir apps/web dev",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "pnpm --dir apps/web build",
    "build:worker": "cd apps/server && go build -o ../../.build/aerosight-worker ./cmd/worker",
    "test": "pnpm test:web && pnpm test:worker",
    "db:migrate": "node scripts/run-server.mjs migrate",
    "test:migrations": "node scripts/legacy-db/db-migrate-test.mjs",
    "test:web": "pnpm --dir apps/web test:unit && node --test contracts/go-migration/legacy-web/*.test.ts",
    "test:worker": "pnpm prepare:server && cd apps/server && go test -tags dev ./...",
    "test:security": "node scripts/test-security-acceptance.mjs",
    "test:dev-proxy": "node scripts/test-dev-proxy.mjs",
    "test:all": "pnpm test && pnpm test:migrations && pnpm test:security",
    "benchmark:load": "node scripts/legacy-db/benchmark-load.mjs",
    "drill:fresh-environment": "node scripts/fresh-environment-drill.mjs",
    "drill:upgrade-rollback": "node scripts/legacy-db/upgrade-rollback-drill.mjs",
    "typecheck": "pnpm --dir apps/web typecheck",
    "check": "pnpm check:web-boundary && pnpm typecheck && pnpm test",
    "check:web-boundary": "node scripts/check-web-boundary.mjs",
    "db:generate": "node scripts/sqlc.mjs",
    "db:check": "node scripts/sqlc.mjs --check",
    "prepare:server": "node scripts/prepare-server.mjs",
    "prepare:web": "node scripts/prepare-web.mjs",
    "dev:server": "node scripts/run-server.mjs dev",
    "build:server": "node scripts/build-server.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.10.0",
    "pg": "8.23.0",
    "@types/pg": "^8.23.1"
  }
}
