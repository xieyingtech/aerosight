DATABASE_URL=postgres://postgres:postgres@localhost:5432/aerosight?sslmode=disable
AUTH_SECRET=replace-with-a-random-secret
LOG_LEVEL=info
OBJECT_STORAGE_LOCAL_ROOT=.aerosight-objects
ALGORITHM_ALLOWED_HOSTS=algorithm.example.test
DJI_FLIGHTHUB_ENABLED=false
DJI_FLIGHTHUB_API_BASE_URL=https://es-flight-api-cn.djigate.com
DJI_FLIGHTHUB_HTTP_TIMEOUT_MS=8000
DJI_FLIGHTHUB_MAX_RETRIES=2
DJI_FLIGHTHUB_MAX_PROJECT_PAGES=50
DJI_FLIGHTHUB_MAX_RESPONSE_BYTES=4194304
