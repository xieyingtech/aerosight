DATABASE_URL=postgres://postgres:postgres@localhost:5432/aerosight?sslmode=disable
APP_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-32-random-bytes-in-base64
AEROSIGHT_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:3000
GO_API_ORIGIN=http://127.0.0.1:8080
LOGIN_RATE_LIMIT=10
WRITE_RATE_LIMIT=120
SSE_RATE_LIMIT=30
# Empty means forwarding headers are not trusted. Set only actual proxy IPs/CIDRs.
TRUSTED_PROXIES=
LOG_LEVEL=info
AI_REQUEST_TIMEOUT=120s
WORKER_NAME=aerosight-worker
DATA_DIR=.aerosight-objects
ALGORITHM_ALLOWED_HOSTS=algorithm.example.test
CALLBACK_LISTEN_ADDRESS=127.0.0.1:8081
CALLBACK_PUBLIC_BASE_URL=https://aerosight.example.test
MEDIA_API_BASE_URL=http://127.0.0.1:9997
MEDIA_ADMIN_USER=resolve-from-deployment-secret-manager
MEDIA_ADMIN_PASSWORD=resolve-from-deployment-secret-manager
DJI_FLIGHTHUB_ENABLED=false
DJI_FLIGHTHUB_API_BASE_URL=https://es-flight-api-cn.djigate.com
DJI_FLIGHTHUB_HTTP_TIMEOUT_MS=8000
DJI_FLIGHTHUB_MAX_RETRIES=2
DJI_FLIGHTHUB_MAX_PROJECT_PAGES=50
DJI_FLIGHTHUB_MAX_RESPONSE_BYTES=4194304
DJI_FLIGHTHUB_POLL_INTERVAL_SECONDS=300
DJI_FLIGHTHUB_RECONCILE_INTERVAL_SECONDS=15
CSP_MAP_ORIGINS=https://tiles.openfreemap.org,https://demotiles.maplibre.org
# Comma-separated browser-visible MediaMTX origins; production requires HTTPS.
# Exact HTTPS media/RTC origins; matching WSS signaling origins are included automatically.
CSP_MEDIA_ORIGINS=
